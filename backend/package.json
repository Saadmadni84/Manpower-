{
  "name": "manpower-backend",
  "version": "1.0.0",
  "description": "Backend API for Manpower Supply Company website",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:watch": "node --watch server.js",
    "dev:debug": "node --inspect server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "seed": "node scripts/seedDatabase.js",
    "backup": "node scripts/backup.js",
    "migrate": "node scripts/migrate.js",
    "cleanup": "node scripts/cleanup.js",
    "setup": "node scripts/setup-environment.js",
    "quick-start": "./scripts/quick-start.sh",
    "db:health": "curl -s http://localhost:5000/health | python3 -m json.tool || curl -s http://localhost:5000/health",
    "db:seed": "npm run seed",
    "db:reset": "npm run cleanup && npm run seed",
    "seed:footer": "node scripts/seedFooterContent.js"
  },
  "keywords": [
    "manpower",
    "supply",
    "company",
    "api",
    "backend",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Manpower Company",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.40.0",
    "compression": "^1.7.4",
    "connect-mongo": "^5.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.4",
    "slugify": "^1.6.6",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@types/node": "^20.5.1",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "prettier": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-company/manpower-backend.git"
  },
  "bugs": {
    "url": "https://github.com/your-company/manpower-backend/issues"
  },
  "homepage": "https://github.com/your-company/manpower-backend#readme"
}
